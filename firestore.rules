// PRODUCTION RULES - Ensure you run: firebase deploy --only firestore:rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;

      match /shooting-sessions/{sessionId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == userId
        );
      }

      match /drills/{drillId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == userId
        );
      }

      match /challengeProgress/{challengeId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == userId
        );

        match /drillAttempts/{drillId} {
          allow read, write: if request.auth != null && (
            request.auth.uid == userId ||
            request.auth.token.email == userId
          );
        }
      }

      match /badges/{badgeId} {
        allow read, write: if request.auth != null && (
          request.auth.uid == userId ||
          request.auth.token.email == userId
        );
      }
    }

    match /user-scores/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // PRODUCTION: Lock down challenges (read-only for users)
    match /challenges/{challengeId} {
      allow read: if true; // Public read access
      allow write: if false; // No direct writes (use seed script or admin SDK)

      match /drills/{drillId} {
        allow read: if true; // Public read access
        allow write: if false; // No direct writes
      }

      match /leaderboard/{uid} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && request.auth.uid == uid;
      }
    }

    match /series/{seriesId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    match /leaderboards/{leaderboardId} {
      allow read: if true;
      allow write: if false; // Managed by Cloud Functions
    }

    // Drill Sessions - users can read their own sessions
    match /drillSessions/{sessionId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow create: if request.auth != null && request.auth.uid == request.resource.data.uid;
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.uid;
    }

    // User Bullets - users can read/write their own bullet count
    match /userBullets/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && request.auth.uid == userId;
      allow delete: if false; // Prevent deletion
    }

    // ========================================
    // FRIEND SYSTEM RULES
    // ========================================

    // Friendships collection - users can read friendships they're part of
    // Users can create friend requests, update (accept) requests to them, and delete their friendships
    match /friendships/{friendshipId} {
      // Helper function to check if user is part of this friendship (when document exists)
      function isParticipant() {
        return isAuthenticated() && resource != null && (
          resource.data.user1 == request.auth.uid ||
          resource.data.user2 == request.auth.uid
        );
      }

      // Helper function to check if friendship ID contains the user's ID
      function friendshipIdContainsUser() {
        return isAuthenticated() && (
          friendshipId.matches('.*' + request.auth.uid + '.*')
        );
      }

      // Helper function to check if user is part of the incoming friendship
      function isIncomingParticipant() {
        return isAuthenticated() && (
          request.resource.data.user1 == request.auth.uid ||
          request.resource.data.user2 == request.auth.uid
        );
      }

      // Helper function to check if user is the receiver
      function isReceiver() {
        return isAuthenticated() && resource.data.initiatedBy != request.auth.uid && isParticipant();
      }

      // Read: Users can read friendships they're part of (or check if they exist)
      allow read: if isParticipant() || friendshipIdContainsUser();

      // Create: Users can create friend requests where they are the initiator
      allow create: if isIncomingParticipant() &&
                      request.resource.data.initiatedBy == request.auth.uid &&
                      request.resource.data.status == 'pending';

      // Update: Accept request OR Resend request (overwrite)
      allow update: if (isReceiver() &&
                        resource.data.status == 'pending' &&
                        request.resource.data.status == 'accepted')
                    || (isIncomingParticipant() &&
                        request.resource.data.initiatedBy == request.auth.uid &&
                        request.resource.data.status == 'pending');

      // Delete: Either user can delete (unfriend or cancel request)
      allow delete: if isParticipant();
    }
  }
}
